# Copy to web/.env.local and replace these placeholders with your project values.
# Only the public URL and anon/publishable key belong in the browser app.
# Never put a service_role or secret key in a VITE_ variable or this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
